# monday.com source access — server-side only
MONDAY_API_TOKEN=
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# Optional Gemini planning / interpretation provider — server-side only
GEMINI_API_KEY=

# Backward-compatible provider key. Used only when GEMINI_API_KEY is unset.
AI_API_KEY=

# Optional temporal intelligence platform.
# Keep "live" when PostgreSQL history is not configured.
DATABASE_URL=
SKYLARK_DATA_MODE=live
SKYLARK_WORKSPACE_KEY=skylark-command
SKYLARK_STALE_AFTER_MINUTES=60

# Required only when calling the authenticated temporal snapshot sync endpoint.
CRON_SECRET=
