# Core persistence for temporal intelligence + workspace/RBAC state (server-side only)
DATABASE_URL=

# Infrastructure identity for /api/internal/sync/monday (server-side only)
CRON_SECRET=

# Data serving mode. Public demo remains compatible with `live`.
# Authenticated workspace analytics require `temporal_preferred` or `temporal_only`.
SKYLARK_DATA_MODE=live
SKYLARK_WORKSPACE_KEY=skylark-command

# Managed identity provider. Used server-side to validate Supabase Auth access tokens.
# A publishable key is intentionally sufficient; do not add a Supabase secret/service-role key to browser code.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# monday.com API access (server-side only)
MONDAY_API_TOKEN=
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# Gemini executive explanation provider (server-side only; preferred)
GEMINI_API_KEY=

# Backward-compatible AI key. Used only when GEMINI_API_KEY is unset.
AI_API_KEY=
