# monday.com API access (server-side only)
MONDAY_API_TOKEN=
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# Temporal PostgreSQL (server-side only; leave unset for live/default mode)
DATABASE_URL=
# live | temporal_preferred | temporal_only
SKYLARK_DATA_MODE=live
SKYLARK_WORKSPACE_KEY=skylark-command
# Freshness threshold for temporal provenance. For the current Vercel Hobby
# daily schedule, production should explicitly use ~1500 (25h), not this dev default.
SKYLARK_STALE_AFTER_MINUTES=60
# Keep serverless fan-out bounded. Default/recommended value is 1.
SKYLARK_DB_MAX_CONNECTIONS=1

# Vercel Cron/internal sync authorization (server-side only)
CRON_SECRET=

# Gemini executive explanation provider (server-side only; preferred)
GEMINI_API_KEY=

# Backward-compatible AI key. Used only when GEMINI_API_KEY is unset.
AI_API_KEY=
